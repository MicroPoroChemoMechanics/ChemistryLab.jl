% ── activity models: the physics behind the terms ────────────────────────────
%
% Verified from the book itself rather than from a catalog: the title page gives
% "Thermodynamics in Geochemistry / The Equilibrium Model / GREG M. ANDERSON /
% DAVID A. CRERAR / New York Oxford / OXFORD UNIVERSITY PRESS / 1993", and the
% copyright page gives "Copyright (c) 1993 by Oxford University Press, Inc."
% with "ISBN 0-19-506464-X". The PDF in circulation is named 2020, which is a
% scan date; citing that year would be wrong.
%
% Source of two statements in the activity-model documentation that would
% otherwise be assertions: section 17.7.1 (pp. 445-446), where the B-dot term is
% introduced as a deviation function fitted to NaCl and attributed to Helgeson
% (1969), and section 17.8 (from p. 447), where the Pitzer equations are derived
% as a virial / cluster expansion with osmotic pressure replacing pressure --
% which is why they carry one coefficient per ion pair and one per triplet.
@book{AndersonCrerar1993,
  author    = {Anderson, Greg M. and Crerar, David A.},
  title     = {Thermodynamics in Geochemistry: The Equilibrium Model},
  publisher = {Oxford University Press},
  address   = {New York},
  year      = {1993},
  isbn      = {0-19-506464-X},
}

